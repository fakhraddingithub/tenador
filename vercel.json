{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "daemons": {
    "product-jobs": {
      "root": "workers/",
      "entrypoint": "Dockerfile.products",
      "instances": { "iad1": 1 },
      "resources": { "requests": { "memory": "1Gi" } },
      "terminationGracePeriodSeconds": 210
    }
  },
  "crons": [
    {
      "path": "/api/cron/installment-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/review-followup",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/wallet-notifications",
      "schedule": "0 5 * * *"
    }
  ]
}
